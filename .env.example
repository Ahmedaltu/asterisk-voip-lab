# Asterisk ARI
ASTERISK_HOST=asterisk
ASTERISK_PORT=8088
ASTERISK_USERNAME=ava
ASTERISK_PASSWORD=ava-secret

# Local AI Server
LOCAL_WS_URL=ws://local_ai_server:8765
LOCAL_WS_PORT=8765
LOCAL_WS_HOST=0.0.0.0
# STT
LOCAL_STT_BACKEND=vosk
LOCAL_STT_MODEL_PATH=/app/models/stt/vosk-model-small-en-us-0.15
# TTS
LOCAL_TTS_BACKEND=piper
LOCAL_TTS_MODEL_PATH=/app/models/tts/en_US-lessac-medium.onnx
# LLM
LOCAL_LLM_MODEL_PATH=/app/models/llm/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_CONTEXT=512
LOCAL_LLM_MAX_TOKENS=32
# Cloud keys (leave blank for fully local)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# SIP extension passwords
SIP_PASS_101=changeme101
SIP_PASS_102=changeme102
SIP_PASS_BROWSER=changemebrowser
GF_ADMIN_PASSWORD=changeme
